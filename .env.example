# Database Configuration for Docker Local Development
DB_USER=aisi_user
DB_PASSWORD=aisi_password
DB_NAME=aisi_db

# Database Connection URL (for local Docker environment)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://aisi_user:aisi_password@db:5432/aisi_db

# Node Environment
NODE_ENV=development

# Application Configuration
VITE_API_URL=http://localhost:3000

# PgAdmin Configuration (optional, for database management UI)
PGADMIN_EMAIL=admin@aisi.local
PGADMIN_PASSWORD=admin

# Netlify Identity Configuration (if still using for auth in development)
# VITE_NETLIFY_SITE_ID=your_netlify_site_id
# VITE_IDENTITY_URL=https://your-netlify-site.netlify.app

# API Keys and Secrets (add as needed)
# VITE_API_KEY=your_api_key_here
