# Local Development Environment Configuration
# Copy from .env.example and customize as needed

# Database Configuration for Docker Local Development
DB_USER=aisi_user
DB_PASSWORD=aisi_password
DB_NAME=aisi_db

# Database Connection URL (for local Docker environment)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://aisi_user:aisi_password@db:5432/aisi_db

# Node Environment
NODE_ENV=development

# Application Configuration
VITE_API_URL=http://localhost:3000

# PgAdmin Configuration (optional, for database management UI)
PGADMIN_EMAIL=admin@aisi.local
PGADMIN_PASSWORD=admin
